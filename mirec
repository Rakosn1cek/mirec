#!/usr/bin/env bash

# ---------------------------------------------------------------------------------
# Mirec -  Minimalist Recorder CLI
# Author:  Lukas Grumlik - Rakosn1cek
# Created: 2026-04-22
# Version: 0.2.0
# Descriptions: 
# A VA-API powered screen recorder for fanless systems to save it from overheating.
# Dependencies: wf-recorder, slurp, fzf, libnotify
# ---------------------------------------------------------------------------------

# Configuration
SAVE_DIR="$HOME/Videos/Recordings"
PID_FILE="/tmp/mirec.pid"
mkdir -p "$SAVE_DIR"

# 1. STOP LOGIC
if pgrep -x "wf-recorder" > /dev/null; then
    killall -SIGINT wf-recorder
    rm -f "$PID_FILE"
    notify-send -t 2000 "Mirec" "Recording Stopped & Saved"
    exit 0
fi

# 2. SELECTION TUI (fzf)
HEADER_TEXT="
                  MIREC v0.2.0
           Minimalist Recording CLI
"
# Combine targets and presets into a single interactive layout
OPTS=$(echo -e "Area (High Quality)\nArea (Low Bitrate)\nArea (720p Scaling)\nFullscreen (High Quality)\nFullscreen (Low Bitrate)\nFullscreen (720p Scaling)\nArea + Audio\nFullscreen + Audio" | fzf --header="$HEADER_TEXT" --header-first --reverse)

# Exit if no option is selected
[ -z "$OPTS" ] && exit 1

# 3. FILENAME INPUT
HEADER_TEXT="
                  MIREC v0.2.0
           Minimalist Recording CLI
           
           
Enter filename (Enter for timestamp):"

RAW_INPUT=$(echo "" | fzf --print-query --header="$HEADER_TEXT")
FILENAME=$(echo "$RAW_INPUT" | tail -n1 | tr -d '\n')
[ -z "$FILENAME" ] && FILENAME="rec_$(date +%Y%m%d_%H%M%S)"
[[ "$FILENAME" != *.mp4 ]] && FILENAME="$FILENAME.mp4"

# 4. LOGIC ENGINE (Parsing the options)
ARG_GEOM=""
ARG_AUDIO=""
ARG_PARAM="-p"
ARG_VAL="qp=24"
ARG_FILTER=""

# Geometry
if [[ "$OPTS" == *"Area"* ]]; then
    ARG_GEOM=$(slurp) || exit 1
fi

# Audio (Using default Pipewire/Pulse source)
if [[ "$OPTS" == *"Audio"* ]]; then
    ARG_AUDIO="--audio"
fi

# Presets for both Area and Fullscreen targets
if [[ "$OPTS" == *"Low Bitrate"* ]]; then
    ARG_PARAM="-p"
    ARG_VAL="max_rate=12000000"
elif [[ "$OPTS" == *"720p Scaling"* ]]; then
    ARG_PARAM="-p"
    ARG_FILTER="-F scale_vaapi=w=1280:h=-2:format=nv12"
fi

# 5. START DELAY
sleep 2

# 6. EXECUTION
nohup wf-recorder \
    ${ARG_GEOM:+-g "$ARG_GEOM"} \
    $ARG_AUDIO \
    --codec h264_vaapi \
    $ARG_PARAM "$ARG_VAL" \
    ${ARG_FILTER:+$ARG_FILTER} \
    -d /dev/dri/renderD128 \
    -f "$SAVE_DIR/$FILENAME" < /dev/null >/dev/null 2>&1 &

echo $! > "$PID_FILE"
notify-send -t 500 "Mirec" "Recording started: $OPTS"
